NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
# Use the publishable key, or the legacy anon key below. Never a service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
VOICE_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Server-only scheduler credential; POST /api/internal/voice-worker every 30s.
VOICE_WORKER_SECRET=
# Room lifecycle scheduler secret (POST /api/internal/rooms-lifecycle);
# falls back to VOICE_WORKER_SECRET. Needs SUPABASE_SERVICE_ROLE_KEY.
ROOMS_LIFECYCLE_SECRET=
# Server-only Hyperbeam key for the shared browser; leave empty to hide it.
HYPERBEAM_API_KEY=
# Server-only VK API access token (video.get) to find VK's embed player from
# a plain VK video link; leave empty to ask members for VK's export code.
VK_ACCESS_TOKEN=
SENTRY_DSN=
EMAIL_FROM=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
# Public playlist imports; server-only provider credentials.
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# App credentials alone do not activate Spotify's current user-scoped playlist API.
# Follow docs/en/Features/Music Activation.md before claiming live import support.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
